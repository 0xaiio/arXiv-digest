[run]
# 只统计 13 个主流程模块（测试自身、tmp 沙箱、output 产物都不应计入分母）
source = .
omit =
    tests/*
    tmp_pytest/*
    output/*
    tools/*
    presets/*

[report]
# 门槛：整体行覆盖率不得低于 85%。当前实测 87%（见 docs/contributing/testing.md）
fail_under = 85
show_missing = True
skip_covered = False
precision = 0

[html]
directory = output/coverage

[xml]
output = output/coverage.xml

[exclude_lines]
# CLI 入口与真·网络桩：无法在无网/无交互环境里稳定执行
pragma: no cover
if __name__ == "__main__":
