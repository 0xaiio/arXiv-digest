# arXiv-digest —— 只提交代码 / 配置 / 文档；运行态、个人数据与凭据一律不入库。
# 这是**公开**仓库：出现任何凭据、本地绝对路径数据或第三方个人信息都算事故。

# ---------------------------------------------------------------- 运行产物
# 日报 / 评分 / 索引 / 抓取缓存 / 归档库 / 行为画像 / 下载记录
output/
outputs/

# 抓取失败的坏快照、日志与临时文件
*.log
*.bad_*
*.tmp
*.temp
*.part

# ---------------------------------------------------------------- 个人配置与画像
# 只有模板（*.example.json）和个人预设（presets/<名字>/）入库；
# 你本机正在用的 config.json / interests.json 属于个人数据，默认不进版本库。
/config.json
/interests.json

# ---------------------------------------------------------------- 本地数据
# 下载目录与库文件的副本（含本机绝对路径、个人使用记录）
library.json*
behavior.json
profile_state.json
profiles_state.json
*.db-journal

# ---------------------------------------------------------------- 凭据（绝不入库）
.secrets/
cookies.json
**/cookies.json
**/*cookie*.json
**/*session*.json
**/token.json
**/credentials*.json
*.pem
*.key
.env
.env.*

# ---------------------------------------------------------------- WorkBuddy 元数据
# 会话记忆、自动化记录属本机状态；skills 是工具代码，随项目走
.workbuddy/*
!.workbuddy/skills/

# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------- Node / Remotion
node_modules/
reel/out/
reel/.remotion/
reel/public/audio/
npm-debug.log*

# ---------------------------------------------------------------- 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------- 探针截图
# tools/ui_*.png 是自检脚本产生的截图，不随仓库分发
tools/ui_*.png
